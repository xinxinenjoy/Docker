# ============================================================================
# 115organize 配置 —— 复制成 .env 后按需改。
# 全部都有默认值，**不填也能跑**；下面标「必填」的才是真需要的。
# ============================================================================

# ---------------------------------------------------------------- 115 账号
# 必填（三选一）：
#   ① 直接写在这里
#   ② 放 /data/cookie.txt
#   ③ 挂 115offline 的 /data 卷，直接复用它的 accounts.json（推荐，cookie 只维护一份）
P115_COOKIE=

# ---------------------------------------------------------------- 整理范围
# 相对 115 网盘根目录的路径。目录树导出件的一级目录就是它。
ROOT_PATH=云下载

# 目录树导出件的落点（容器内路径）。
# 把导出的 .txt 放进这个目录，`plan` 会自己挑最新的那份。
TREE_DIR=/data/tree
# 指定文件名（留空 = 取 TREE_DIR 里最新的那份）
TREE_FILE=

# ---------------------------------------------------------------- 番号 / 系列
# 按系列聚合
SERIES_ENABLE=1
# 一个系列至少几部才建目录。默认 3 —— 实测 548 个系列里 262 个（48%）只出现 1 次，
# 给它们建目录纯属制造碎片。调到 1 就等于全部聚合。
SERIES_MIN=3
# 番号目录名要不要一并规范成 `DLDSS-532`（顺带去掉 -ch / -U / [4K]@站点 尾巴）
SERIES_RENAME=1

# ---------------------------------------------------------------- 电影 / 剧集
MOVIE_ENABLE=1
EPISODE_GROUP_ENABLE=1
# 同一部剧至少有这么多集**散落在同一层**才收拢（1 集不值得动）
EPISODE_GROUP_MIN=2
# 年份括号形态：full = 全角（）（默认，跟随你的习惯）；half = 半角()
PAREN=full

# ---------------------------------------------------------------- 垃圾清理
# report     = 只出报告，一个文件都不动（最保守）
# quarantine = 移到 ROOT_PATH/_待清理/<原目录名>/（默认，**可整目录撤销**）
# delete     = 删掉（进 115 回收站，仍可还原，但和还原操作互斥）
JUNK_ACTION=quarantine
# 隔离目录名（相对 ROOT_PATH）
QUARANTINE_DIR=_待清理
# 强特征垃圾还要「跨目录重复 ≥N 次」才自动处理；只有一两次的只进报告。
# 为什么：实测的头部证据全是「重复几十上百次」的推广件，而只出现一两次的里面
# 混着正经作品。调到 1 = 出现即处理（激进，不建议）。
JUNK_DUP_MIN=5

# ---------------------------------------------------------------- 节流（防风控）★
# 三档参考（顺序 = MIN / MAX / BATCH / REST），按自己的盘和胆子挑：
#
#   频繁档（盘小、想快点看完）：      1 / 2 / 500 / 30
#   常规档（默认，就是下面这四个）：  3 / 5 / 200 / 60
#   保守档（刚被风控过 / 盘很大）：   8 / 12 / 100 / 600
#
# 单请求间隔下限（秒）
THROTTLE_MIN=3
# 单请求间隔上限（秒）—— 上下限之间**随机**取，随机比固定节奏更像人
THROTTLE_MAX=5
# 每多少个请求长休一次（「处理一部分之后暂停」）
THROTTLE_BATCH=200
# 长休多少秒
THROTTLE_REST=60
# 只在哪个时段跑，形如 `02:00-06:00`；留空 = 不限。窗外就地等，不退出。
WINDOW=
# 连续失败几次就停手冷却（风控和网络抖动的症状一样，宁可按风控处理）
FAIL_LIMIT=8
FAIL_COOLDOWN=900

# ---------------------------------------------------------------- 自动化
# 定时计划（分 时 日 月 周）。默认每天 04:00（低峰）。
# ⚠️ 这是**全盘/增量**级任务，改频率前先想风控。支持 `*/6`、`1-5`、`MON` 这类写法，
#    写错了容器启动时会**直接报错拒绝运行**（不给「静默永不触发」的机会）。
SCHEDULE_CRON=0 4 * * *
# 每轮只处理「最近接收」里最近 N 天出现过的目录；0 = 不按时间过滤
RECENT_DAYS=3

# ---------------------------------------------------------------- 安全阀 ★
# 1 = 只出方案、不动手（**出厂默认**）。
# 🔴 第一次全量要动 6000+ 个对象、不可逆 —— 先看 plan 报告，确认没问题再改 0。
DRY_RUN=1
LOG_LEVEL=INFO
