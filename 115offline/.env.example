# 访问口令。设置后打开网页需要先输入它。
# 只在局域网用可以留空；一旦映射到公网（反代/端口转发），务必设一个长的。
ACCESS_TOKEN=

# 对外端口（宿主机侧）
PORT=8765

# 目录列表缓存的有效秒数（「网盘整理」页的扫描结果）。
# 默认 300 = 5 分钟自然过期；设 0 = 永不过期、只能点「扫描这一层 / 清缓存」手动刷。
# 改名 / 删除 / 还原 / 推送之后缓存一定会自动失效，不用管这个值。
FOLDER_CACHE_TTL=300

# ---- 分批推送（115 单请求最多认 100 条，超出的部分后端自己切批推完）----
# 每批多少条：115 的硬限就是 100，只能调小（调小 = 请求更多、更稳但更慢）
PUSH_CHUNK=100
# 批间隔秒数：躲风控主要靠它，嫌慢也别低于 1~2 秒
PUSH_DELAY=3.0
# 一次提交的总条数上限（默认 3000，按 100 条/批 + 3 秒间隔 ≈ 90 秒跑完）
PUSH_MAX_TOTAL=3000
