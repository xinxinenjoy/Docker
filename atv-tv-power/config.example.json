{
  "_comment": "示例模板。⚠️ tv.port=6095 是【小米电视】的局域网 HTTP 控制接口端口；本项目只在小米电视上实测过，其它品牌未测试、端口未必一致 —— 用前请确认你的电视是否有等价接口及真实端口（详见 README 的「设备支持范围」）。",
  "delay_seconds": 5,
  "poll_seconds": 30,
  "retries": 3,
  "retry_interval": 5,
  "reconnect_delay": 30,
  "atv": {
    "host": "192.168.1.100",
    "credentials": "（留空由程序首次配对生成，或从 keys/atv_credentials.json 填）"
  },
  "tv": {
    "host": "192.168.1.101",
    "port": 6095,
    "timeout": 4,
    "verify_delay": 4
  },
  "bark": {
    "enabled": true,
    "server": "https://api.day.app",
    "key": "",
    "key_file": "keys/bark.json",
    "group": "docker",
    "sound": "healthnotification",
    "icon": "https://example.com/icon.png",
    "offline_after": 3
  },
  "guard": {
    "enabled": true,
    "on_unknown": "skip"
  }
}
